import atelier.widgets.overlay;
import atelier.widgets.paragraph;
import atelier.buffer;
import atelier.layout;
import atelier.style;
import atelier.text;
import std.test;

#[test]
void clear_erases_only_its_region() {
    Rect area = Rect.new((u16)0, (u16)0, (u16)10, (u16)3);
    Buffer buf = Buffer.empty(area);
    Text t = Text.from("hello world");
    Paragraph p = Paragraph.new(move t).wrap(false);
    p.render(&area, &buf);
    assert_eq_i64(0x68, (i64)buf.cell_mut(0, 0).ch, "text renders first");
    Clear c = Clear.new();
    Rect hole = Rect.new((u16)0, (u16)0, (u16)5, (u16)1);
    c.render(&hole, &buf);
    assert_eq_i64(0, (i64)buf.cell_mut(0, 0).ch, "cleared cell is empty");
    assert_eq_i64(0x77, (i64)buf.cell_mut(6, 0).ch, "cells outside survive");
}

#[test]
void fill_paints_symbol_cells() {
    Rect area = Rect.new((u16)0, (u16)0, (u16)4, (u16)2);
    Buffer buf = Buffer.empty(area);
    Fill f = Fill.new("~").style(Style.new().bold());
    f.render(&area, &buf);
    assert_eq_i64(126, (i64)buf.cell_mut(0, 0).ch, "fill starts with symbol");
    assert_eq_i64(126, (i64)buf.cell_mut(3, 1).ch, "fill reaches last cell");
    Color reset = Color.Reset;
    assert_true(buf.cell_mut(3, 1).fg == reset, "fill keeps default fg");
}

#[test]
void centered_rect_centers_and_clamps() {    Rect screen = Rect.new((u16)0, (u16)0, (u16)80, (u16)24);
    Rect pop = centered_rect(screen, (u16)20, (u16)6);
    assert_eq_i64(30, (i64)pop.x, "popup centered horizontally");
    assert_eq_i64(9, (i64)pop.y, "popup centered vertically");
    assert_eq_i64(20, (i64)pop.width, "popup keeps width");
    Rect wide = centered_rect(screen, (u16)100, (u16)30);
    assert_eq_i64(0, (i64)wide.x, "oversize clamps to origin");
    assert_eq_i64(80, (i64)wide.width, "oversize clamps to area");
    assert_eq_i64(24, (i64)wide.height, "oversize clamps height");
}
