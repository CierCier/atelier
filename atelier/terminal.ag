// Terminal driver: double-buffered rendering with minimal escape output.
//
// The application renders widgets into the back buffer (via Frame), then
// flush() diffs against the front buffer and emits only changed cells:
// cursor moves are skipped for adjacent cells and style changes re-emit
// SGR from a tracked baseline. No closures: the loop is explicit.
//
//     Terminal t = Terminal.full_screen(&STDOUT);
//     t.hide_cursor();
//     Frame f = t.frame();
//     my_ui(&f);
//     t.flush();

import std.mem.vec;
import std.io.file;
import std.ops;
import std.term;
import atelier.style;
import atelier.buffer;
import atelier.layout;
import atelier.widget;

struct Frame {
    Buffer* buf;
    Rect area;
}

/// Max unchanged cells rewritten to bridge a gap between changed runs.
/// A cursor move costs roughly as much as the glyphs it skips and can split
/// a row into two output chunks; three-glyph gaps cost ~1 byte per cell.
const i64 FLUSH_GAP_FILL = 3;

struct Terminal {
    Buffer cur;
    Buffer prev;
    Rect area;
    BufWriter* out;
    Style pen;
    i64 pen_x;
    i64 pen_y;
    // Inline viewports address cells relative to a reserved scrollback
    // region (absolute moves would land on screen top); fullscreen uses
    // absolute moves. pen stays exact in both modes.
    bool relative;
}

/// Encode one codepoint as UTF-8 into the writer (surrogates become '?').
void write_codepoint(BufWriter* out, u32 cp) {
    if (cp < (u32)0x80) {
        out.write_u8((u8)cp);
    } else if (cp < (u32)0x800) {
        out.write_u8((u8)((u32)0xC0 | (cp >> (u32)6)));
        out.write_u8((u8)((u32)0x80 | (cp & (u32)0x3F)));
    } else if (cp < (u32)0x10000) {
        if (cp >= (u32)0xD800 && cp <= (u32)0xDFFF) {
            cp = (u32)63; // '?'
        }
        out.write_u8((u8)((u32)0xE0 | (cp >> (u32)12)));
        out.write_u8((u8)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
        out.write_u8((u8)((u32)0x80 | (cp & (u32)0x3F)));
    } else {
        out.write_u8((u8)((u32)0xF0 | (cp >> (u32)18)));
        out.write_u8((u8)((u32)0x80 | ((cp >> (u32)12) & (u32)0x3F)));
        out.write_u8((u8)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
        out.write_u8((u8)((u32)0x80 | (cp & (u32)0x3F)));
    }
}

void term_write_fg(BufWriter* out, &Color c) {
    match *c {
        Black : { term_set_fg(out, TERM_BLACK); },
        Red : { term_set_fg(out, TERM_RED); },
        Green : { term_set_fg(out, TERM_GREEN); },
        Yellow : { term_set_fg(out, TERM_YELLOW); },
        Blue : { term_set_fg(out, TERM_BLUE); },
        Magenta : { term_set_fg(out, TERM_MAGENTA); },
        Cyan : { term_set_fg(out, TERM_CYAN); },
        White : { term_set_fg(out, TERM_WHITE); },
        BrightBlack : { term_set_fg(out, TERM_BLACK + TERM_BRIGHT); },
        BrightRed : { term_set_fg(out, TERM_RED + TERM_BRIGHT); },
        BrightGreen : { term_set_fg(out, TERM_GREEN + TERM_BRIGHT); },
        BrightYellow : { term_set_fg(out, TERM_YELLOW + TERM_BRIGHT); },
        BrightBlue : { term_set_fg(out, TERM_BLUE + TERM_BRIGHT); },
        BrightMagenta : { term_set_fg(out, TERM_MAGENTA + TERM_BRIGHT); },
        BrightCyan : { term_set_fg(out, TERM_CYAN + TERM_BRIGHT); },
        BrightWhite : { term_set_fg(out, TERM_WHITE + TERM_BRIGHT); },
        Indexed(n) : { term_set_fg256(out, (i64)n); },
        Rgb(r, g, b) : { term_set_fg_rgb(out, (i64)r, (i64)g, (i64)b); },
        _ : {},
    }
}

void term_write_bg(BufWriter* out, &Color c) {
    match *c {
        Black : { term_set_bg(out, TERM_BLACK); },
        Red : { term_set_bg(out, TERM_RED); },
        Green : { term_set_bg(out, TERM_GREEN); },
        Yellow : { term_set_bg(out, TERM_YELLOW); },
        Blue : { term_set_bg(out, TERM_BLUE); },
        Magenta : { term_set_bg(out, TERM_MAGENTA); },
        Cyan : { term_set_bg(out, TERM_CYAN); },
        White : { term_set_bg(out, TERM_WHITE); },
        BrightBlack : { term_set_bg(out, TERM_BLACK + TERM_BRIGHT); },
        BrightRed : { term_set_bg(out, TERM_RED + TERM_BRIGHT); },
        BrightGreen : { term_set_bg(out, TERM_GREEN + TERM_BRIGHT); },
        BrightYellow : { term_set_bg(out, TERM_YELLOW + TERM_BRIGHT); },
        BrightBlue : { term_set_bg(out, TERM_BLUE + TERM_BRIGHT); },
        BrightMagenta : { term_set_bg(out, TERM_MAGENTA + TERM_BRIGHT); },
        BrightCyan : { term_set_bg(out, TERM_CYAN + TERM_BRIGHT); },
        BrightWhite : { term_set_bg(out, TERM_WHITE + TERM_BRIGHT); },
        Indexed(n) : { term_set_bg256(out, (i64)n); },
        Rgb(r, g, b) : { term_set_bg_rgb(out, (i64)r, (i64)g, (i64)b); },
        _ : {},
    }
}

/// Emit one raw SGR numeric attribute (for modifiers std.term lacks).
void term_write_sgr_num(BufWriter* out, i64 n) {
    term_write_csi(out);
    term_write_num(out, n);
    out.write_u8((u8)109); // 'm'
}

/// SGR foreground parameters only, no CSI prefix or 'm' terminator: for use
/// inside combined sequences. Default is 39; bright bases are 90-97.
void term_write_fg_inner(BufWriter* out, &Color c) {
    match *c {
        Black : { term_write_num(out, 30); },
        Red : { term_write_num(out, 31); },
        Green : { term_write_num(out, 32); },
        Yellow : { term_write_num(out, 33); },
        Blue : { term_write_num(out, 34); },
        Magenta : { term_write_num(out, 35); },
        Cyan : { term_write_num(out, 36); },
        White : { term_write_num(out, 37); },
        BrightBlack : { term_write_num(out, 90); },
        BrightRed : { term_write_num(out, 91); },
        BrightGreen : { term_write_num(out, 92); },
        BrightYellow : { term_write_num(out, 93); },
        BrightBlue : { term_write_num(out, 94); },
        BrightMagenta : { term_write_num(out, 95); },
        BrightCyan : { term_write_num(out, 96); },
        BrightWhite : { term_write_num(out, 97); },
        Indexed(n) : {
            out.write_str("38;5;");
            term_write_num(out, (i64)n);
        },
        Rgb(r, g, b) : {
            out.write_str("38;2;");
            term_write_num(out, (i64)r);
            out.write_u8((u8)59);
            term_write_num(out, (i64)g);
            out.write_u8((u8)59);
            term_write_num(out, (i64)b);
        },
        _ : { term_write_num(out, 39); },
    }
}

/// SGR background parameters only: default 49, bright bases 100-107.
void term_write_bg_inner(BufWriter* out, &Color c) {
    match *c {
        Black : { term_write_num(out, 40); },
        Red : { term_write_num(out, 41); },
        Green : { term_write_num(out, 42); },
        Yellow : { term_write_num(out, 43); },
        Blue : { term_write_num(out, 44); },
        Magenta : { term_write_num(out, 45); },
        Cyan : { term_write_num(out, 46); },
        White : { term_write_num(out, 47); },
        BrightBlack : { term_write_num(out, 100); },
        BrightRed : { term_write_num(out, 101); },
        BrightGreen : { term_write_num(out, 102); },
        BrightYellow : { term_write_num(out, 103); },
        BrightBlue : { term_write_num(out, 104); },
        BrightMagenta : { term_write_num(out, 105); },
        BrightCyan : { term_write_num(out, 106); },
        BrightWhite : { term_write_num(out, 107); },
        Indexed(n) : {
            out.write_str("48;5;");
            term_write_num(out, (i64)n);
        },
        Rgb(r, g, b) : {
            out.write_str("48;2;");
            term_write_num(out, (i64)r);
            out.write_u8((u8)59);
            term_write_num(out, (i64)g);
            out.write_u8((u8)59);
            term_write_num(out, (i64)b);
        },
        _ : { term_write_num(out, 49); },
    }
}

/// Resolve a cell to its glyph: 0 (empty) renders as a space. Wide leads
// already carry their own trailer bookkeeping via continuation cells.
u32 cell_glyph(&Cell c) {
    if (c.ch == (u32)0) {
        return (u32)32;
    }
    return c.ch;
}

/// Emit a reset-free style: only the attributes that differ from `from`
/// (an optional baseline) are written, in one combined SGR sequence. When
/// `from` carries modifiers, fg/bg SGR codes naturally do not disturb them,
/// so bold/dim/italic survive recolors instead of flickering off and on.
/// Pass from == 0 for a blank baseline; mods never added implicitly.
void term_write_style_diff(BufWriter* out, &Style s, Style* from) {
    bool fg_diff = true;
    bool bg_diff = true;
    u16 old_mods = (u16)0;
    if (from != (Style*)0) {
        fg_diff = s.fg != (*from).fg;
        bg_diff = s.bg != (*from).bg;
        old_mods = (*from).add_mod & ~(*from).sub_mod;
        if (!fg_diff && !bg_diff && s.add_mod == (*from).add_mod && s.sub_mod == (*from).sub_mod) {
            return;
        }
    }
    u16 mods = s.add_mod & ~s.sub_mod;
    bool mods_diff = mods != old_mods;
    if (!fg_diff && !bg_diff && !mods_diff) {
        return;
    }
    term_write_csi(out);
    bool any = false;
    if (mods_diff) {
        // Turn off exactly the bits the baseline added that we do not want;
        // then add ours. (22=bold/dim off, 23=italic off, 29=crossed off,
        // 24=underline off, 25=blink off, 27=reversed off, 28=hidden off.)
        u16 off = old_mods & ~mods;
        if ((off & MOD_BOLD) != (u16)0 || (off & MOD_DIM) != (u16)0) {
            term_write_num(out, 22);
            any = true;
        }
        if ((off & MOD_ITALIC) != (u16)0) {
            term_write_num(out, 23);
            any = true;
        }
        if ((off & MOD_UNDERLINED) != (u16)0) {
            term_write_num(out, 24);
            any = true;
        }
        if ((off & (MOD_SLOW_BLINK | MOD_RAPID_BLINK)) != (u16)0) {
            term_write_num(out, 25);
            any = true;
        }
        if ((off & MOD_REVERSED) != (u16)0) {
            term_write_num(out, 27);
            any = true;
        }
        if ((off & MOD_HIDDEN) != (u16)0) {
            term_write_num(out, 28);
            any = true;
        }
        if ((off & MOD_CROSSED_OUT) != (u16)0) {
            term_write_num(out, 29);
            any = true;
        }
        if ((mods & MOD_BOLD) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 1);
            any = true;
        }
        if ((mods & MOD_DIM) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 2);
            any = true;
        }
        if ((mods & MOD_ITALIC) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 3);
            any = true;
        }
        if ((mods & MOD_UNDERLINED) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 4);
            any = true;
        }
        if ((mods & MOD_SLOW_BLINK) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 5);
            any = true;
        }
        if ((mods & MOD_RAPID_BLINK) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 6);
            any = true;
        }
        if ((mods & MOD_REVERSED) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 7);
            any = true;
        }
        if ((mods & MOD_HIDDEN) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 8);
            any = true;
        }
        if ((mods & MOD_CROSSED_OUT) != (u16)0) {
            if (any) { out.write_u8((u8)59); }
            term_write_num(out, 9);
            any = true;
        }
    }
    if (fg_diff) {
        if (any) { out.write_u8((u8)59); }
        term_write_fg_inner(out, &s.fg);
        any = true;
    }
    if (bg_diff) {
        if (any) { out.write_u8((u8)59); }
        term_write_bg_inner(out, &s.bg);
        any = true;
    }
    if (any) {
        out.write_u8((u8)109); // 'm'
    }
}

/// Emit one raw SGR numeric attribute (for modifiers std.term lacks).
void term_write_mods(BufWriter* out, u16 mods) {
    if ((mods & MOD_BOLD) != (u16)0) {
        term_write_sgr_num(out, 1);
    }
    if ((mods & MOD_DIM) != (u16)0) {
        term_write_sgr_num(out, 2);
    }
    if ((mods & MOD_ITALIC) != (u16)0) {
        term_write_sgr_num(out, 3);
    }
    if ((mods & MOD_UNDERLINED) != (u16)0) {
        term_write_sgr_num(out, 4);
    }
    if ((mods & MOD_SLOW_BLINK) != (u16)0) {
        term_write_sgr_num(out, 5);
    }
    if ((mods & MOD_RAPID_BLINK) != (u16)0) {
        term_write_sgr_num(out, 6);
    }
    if ((mods & MOD_REVERSED) != (u16)0) {
        term_write_sgr_num(out, 7);
    }
    if ((mods & MOD_HIDDEN) != (u16)0) {
        term_write_sgr_num(out, 8);
    }
    if ((mods & MOD_CROSSED_OUT) != (u16)0) {
        term_write_sgr_num(out, 9);
    }
}

impl Terminal {
    Terminal new(BufWriter* out, Rect area) {
        Terminal t;
        t.cur = Buffer.empty(area);
        t.prev = Buffer.empty(area);
        t.area = area;
        t.out = out;
        t.pen = Style.new();
        t.pen_x = -1;
        t.pen_y = -1;
        t.relative = false;
        return move t;
    }

    /// Size from our own tty, falling back to 80x24 (pipes, tests).
    Terminal full_screen(BufWriter* out) {
        i64 rows = 24;
        i64 cols = 80;
        Result<TermSize, Error> r = term_get_size(0);
        if (r.is_ok()) {
            TermSize t = r.unwrap();
            if (t.rows > 0 && t.cols > 0) {
                rows = t.rows;
                cols = t.cols;
            }
        }
        return Terminal.new(out, Rect.new((u16)0, (u16)0, (u16)cols, (u16)rows));
    }

    /// Fixed-height region in the scrollback (agent CLIs): no alt screen,
    // content persists above and below after exit. Width still tracks tty.
    Terminal inline(BufWriter* out, u16 height) {
        i64 cols = 80;
        Result<TermSize, Error> r = term_get_size(0);
        if (r.is_ok()) {
            TermSize t = r.unwrap();
            if (t.cols > 0) {
                cols = t.cols;
            }
        }
        Terminal t = Terminal.new(out, Rect.new((u16)0, (u16)0, (u16)cols, height));
        t.relative = true;
        return move t;
    }

    /// Reserve the region: CRLF per row scrolls it into view, then up to
    // its top-left. Pen starts exact so all later moves stay relative.
    void enter_inline(&mut self) {
        i64 h = (i64)self.area.height;
        for (i64 i = 0; i < h; i = i + 1) {
            self.out.write_u8((u8)13);
            self.out.write_u8((u8)10);
        }
        if (h > 0) {
            term_cursor_up(self.out, h);
        }
        self.out.flush();
        self.pen_x = 0;
        self.pen_y = 0;
    }

    /// Drop the cursor below the region; the region itself stays put.
    void exit_inline(&mut self) {
        i64 down = (i64)self.area.height - self.pen_y;
        if (down < 1) {
            down = 1;
        }
        term_cursor_down(self.out, down);
        self.out.flush();
    }

    /// Re-anchor the style pen to the terminal's real SGR state. We only
    // model the attributes we emit, so any earlier output (shell, build
    // logs, a previous frame) can leave bold/reverse active. Differential
    // emission then believes plain cells need nothing — and the stale
    // attributes paint them as solid blocks. An explicit reset makes the
    // baseline real before any cell work proceeds.
    void sync_pen(&mut self) {
        term_sgr_reset(self.out);
        self.pen = Style.new();
    }

    /// Single funnel for every cursor move: absolute in fullscreen,
    // relative deltas in inline mode (n=0 would emit as 1, so skip axes).
    void goto_cell(&mut self, i64 x, i64 y) {
        if (!self.relative) {
            term_move_to(self.out, y + 1, x + 1);
        } else {
            i64 dy = y - self.pen_y;
            if (dy < 0) {
                term_cursor_up(self.out, 0 - dy);
            } else if (dy > 0) {
                term_cursor_down(self.out, dy);
            }
            i64 dx = x - self.pen_x;
            if (dx < 0) {
                term_cursor_back(self.out, 0 - dx);
            } else if (dx > 0) {
                term_cursor_forward(self.out, dx);
            }
        }
        self.pen_x = x;
        self.pen_y = y;
    }

    /// Start a fresh frame. Widgets are immediate-mode: every cell must be
    /// resolved from the current application state, never inherited from an
    /// older frame.
    Frame frame(&mut self) {
        self.cur.reset();
        Frame f;
        f.buf = &self.cur;
        f.area = self.area;
        return f;
    }

    void hide_cursor(*self) {
        term_hide_cursor(self.out);
        self.out.flush();
    }

    void show_cursor(*self) {
        term_show_cursor(self.out);
        self.out.flush();
    }

    // Hardware cursor for focused inputs (TextInput.cursor_pos supplies the
    // cell). Tracks pen so the next flush skips its own move when adjacent.
    void place_cursor(&mut self, i64 x, i64 y) {
        self.goto_cell(x, y);
        self.out.flush();
    }

    /// Emit one cell at (x, y): reposition if the pen is not already there,
    /// write the differential style, then the glyph. Wide leads advance the
    /// pen two cells (the trailer is painted by the terminal itself).
    void emit_cell(&mut self, i64 x, i64 y, Cell* c) {
        if (x != self.pen_x || y != self.pen_y) {
            self.goto_cell(x, y);
        }
        self.pen_y = y;
        Style cs;
        cs.fg = c.fg;
        cs.bg = c.bg;
        cs.add_mod = c.mods;
        cs.sub_mod = (u16)0;
        term_write_style_diff(self.out, &cs, &self.pen);
        self.pen = cs;
        write_codepoint(self.out, cell_glyph(c));
        Cell* nxt = self.cur.cell_mut(x + 1, y);
        if (nxt != (Cell*)0 && nxt.continuation) {
            self.pen_x = x + 2;
        } else {
            self.pen_x = x + 1;
        }
    }

    /// Column of the next changed cell in row y within [from, limit), or
    /// limit when none. Bounds the gap-fill lookahead.
    i64 next_changed(&self, i64 y, i64 from, i64 limit, i64 w) {
        i64 base = y * w;
        for (i64 x = from; x < limit; x = x + 1) {
            Cell* c = self.cur.cells.get_ptr(base + x);
            Cell* o = self.prev.cells.get_ptr(base + x);
            if (!cell_eq(c, o)) {
                return x;
            }
        }
        return limit;
    }

    /// Diff the back buffer to the screen, then rotate buffers. The new
    /// back buffer keeps its (stale) contents: the application re-renders
    /// fully every frame, and untouched cells diff clean.
    ///
    /// Streams one row at a time with no intermediate update list: clean
    /// rows cost a pointer sweep and nothing else; dirty rows emit one move
    /// per run. Short same-style gaps between updates are rewritten instead
    /// of skipped so a dirty run with small holes still lands as one chunk
    /// (fewer escapes, no split-row tearing).
    void flush(&mut self) {
        i64 w = (i64)self.cur.area.width;
        i64 h = (i64)self.cur.area.height;
        for (i64 y = 0; y < h; y = y + 1) {
            i64 base = y * w;
            i64 first = -1;
            i64 last = -1;
            for (i64 x = 0; x < w; x = x + 1) {
                Cell* c = self.cur.cells.get_ptr(base + x);
                Cell* o = self.prev.cells.get_ptr(base + x);
                if (!cell_eq(c, o)) {
                    if (first < 0) {
                        first = x;
                    }
                    last = x;
                }
            }
            if (first < 0) {
                continue;
            }
            for (i64 x = first; x <= last; x = x + 1) {
                Cell* c = self.cur.cells.get_ptr(base + x);
                Cell* o = self.prev.cells.get_ptr(base + x);
                if (cell_eq(c, o)) {
                    // Unchanged cell: rewrite it only while it bridges a
                    // short distance to the next change — glyphs plus at
                    // most one style diff always beat a move + re-style.
                    if (self.pen_x == x && self.pen_y == y
                        && self.next_changed(y, x + 1, last + 1, w) - x <= FLUSH_GAP_FILL) {
                        self.emit_cell(x, y, c);
                    }
                    continue;
                }
                if (c.continuation) {
                    // Metadata for the preceding wide glyph, not a terminal
                    // cell; the pen already stepped over it. The terminal
                    // paints the second half from the glyph itself.
                    continue;
                }
                self.emit_cell(x, y, c);
            }
        }
        self.out.flush();
        Buffer tmp = move self.cur;
        self.cur = move self.prev;
        self.prev = move tmp;
    }

    /// Erase the screen and forget all state (forces a full redraw next).
    void clear(&mut self) {
        if (self.relative) {
            self.sync_pen();
            // Absolute erase would wipe scrollback above: blank region rows.
            for (i64 row = 0; row < (i64)self.area.height; row = row + 1) {
                self.goto_cell(0, row);
                term_erase_line(self.out);
            }
            self.out.flush();
            self.cur.reset();
            self.prev.reset();
            self.pen = Style.new();
            return;
        }
        self.sync_pen();
        term_erase_screen(self.out);
        term_move_to(self.out, 1, 1);
        self.out.flush();
        self.cur.reset();
        self.prev.reset();
        self.pen = Style.new();
        self.pen_x = -1;
        self.pen_y = -1;
    }

    /// Invalidate the terminal after an external screen change. The next
    /// frame is rendered from an empty baseline.
    void refresh(&mut self) {
        self.clear();
    }

    /// Resize both buffers, forgetting contents.
    void resize(&mut self, i64 cols, i64 rows) {
        Rect a = Rect.new((u16)0, (u16)0, (u16)cols, (u16)rows);
        self.area = a;
        self.cur.resize(a);
        self.prev.resize(a);
        self.sync_pen();
        // Relative pen must stay exact (deltas derive from it); absolute
        // positioning re-anchors freely.
        if (!self.relative) {
            self.pen_x = -1;
            self.pen_y = -1;
        }
    }
}
