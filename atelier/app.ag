// Application runner: raw mode, alt screen, event loop with tick hooks.
//
// Implement App for your state struct and hand it to run_app: keys flow to
// on_key (true quits), on_tick fires every tick_ms, render draws each
// frame with activity. Resize is tracked automatically. No closures: all
// dispatch is trait calls. Lone ESC resolves after 50ms without a follower.

import std.io.file;
import std.sys.result;
import std.sys.errno;
import std.sys.socket;
import std.time;
import std.term;
import atelier.terminal;

trait App {
    void init(&mut self);
    /// Handle a key; return true to quit.
    bool on_key(&mut self, &KeyEvent e);
    /// Periodic hook; dt_ms is the elapsed time since the last tick.
    void on_tick(&mut self, i64 dt_ms);
    void render(&mut self, &mut Frame f);
    /// Tick interval in ms; 0 disables ticks (input-driven rendering).
    i64 tick_ms(*self);
}

const i64 ESC_TIMEOUT_MS = 50;
// Idle poll cap. The loop blocks in poll(2) instead of sleeping in a spin,
// so this only bounds how late a terminal resize is noticed for tick-less
// apps; ticked apps wake at their next deadline instead.
const i64 IDLE_POLL_MS = 250;
// Focus cell: the single hardware cursor is process-global by nature, so the
// protocol lives here instead of the App trait (a trait hook would break
// every existing App impl). The loop clears each frame; a focused widget
// publishes during render; the loop places or hides after flush.
i64 g_focus_x;
i64 g_focus_y;
bool g_focus_set;

void focus_clear() {
    g_focus_set = false;
}

void focus_set(i64 x, i64 y) {
    g_focus_x = x;
    g_focus_y = y;
    g_focus_set = true;
}

/// Take the published cell; drains it so a widget that stops rendering
// focused cannot leave a stale cursor behind.
bool focus_take(i64* out_x, i64* out_y) {
    if (!g_focus_set) {
        return false;
    }
    *out_x = g_focus_x;
    *out_y = g_focus_y;
    g_focus_set = false;
    return true;
}

enum Viewport {
    Fullscreen;
    Inline(u16);
}

bool viewport_is_inline(Viewport port) {
    return match port {
        Inline(h) : true,
        _ : false,
    };
}

u16 viewport_height(Viewport port) {
    return match port {
        Inline(h) : h,
        _ : 0,
    };
}

void run_app<A>(&mut A app) {
    run_app_view(&mut app, Viewport.Fullscreen);
}

void run_app_view<A>(&mut A app, Viewport port) {
    if (!term_is_tty(0)) {
        STDOUT.write_str("run_app needs a terminal on stdin\n");
        STDOUT.flush();
        return;
    }
    Result<RawMode, Error> g = RawMode.enable(0);
    if (g.is_err()) {
        STDOUT.write_str("run_app: raw mode failed\n");
        STDOUT.flush();
        return;
    }
    RawMode _guard = g.unwrap();

    // Nonblocking stdin (restored below); reads then never stall ticks.
    Result<i64, Error> saved = try_fcntl(0, F_GETFL, 0);
    bool restd = false;
    i64 saved_flags = 0;
    if (saved.is_ok()) {
        saved_flags = saved.value();
        restd = try_fcntl(0, F_SETFL, saved_flags | O_NONBLOCK).is_ok();
    }

    Terminal t = Terminal.full_screen(&STDOUT);
    bool inline_mode = viewport_is_inline(port);
    u16 inline_height = viewport_height(port);
    if (inline_mode) {
        t = Terminal.inline(&STDOUT, inline_height);
    }
    t.hide_cursor();
    // Establish a known SGR baseline: whatever the shell or build output
    // left active (bold, reverse) would otherwise persist across exec and
    // alt-screen, and differential style emission would believe plain
    // cells need no escape — painting them with the stale attributes.
    t.sync_pen();
    if (!inline_mode) {
        term_enter_alt(&STDOUT);
        STDOUT.flush();
    } else {
        t.enter_inline();
    }

    app.init();
    KeyParser keys = KeyParser.new();
    bool seq_open = false;
    Instant last_byte = now();
    bool quit = false;
    bool first = true;
    bool cursor_shown = false;
    // Tick deadlines live on the monotonic clock in ms since `start`.
    // Firing late never accumulates drift: the next deadline is recomputed
    // from the current time, and on_tick receives true elapsed ms so
    // UpdateInterval widgets step the right number of boundaries even
    // across slow frames.
    Instant start = now();
    i64 last_tick_fire = 0;
    // next_tick = 0 fires the first tick immediately, which also draws the
    // first frame for ticked apps (tick-less apps draw via `first`).
    i64 next_tick = 0;
    // One pollfd for stdin; every idle wait blocks here instead of sleeping
    // in a spin loop, so idle apps make zero wakeups per frame.
    PollFd pfd;
    pfd.fd = 0;
    pfd.events = (i16)POLLIN;
    pfd.revents = 0;
    while (!quit) {
        bool activity = first;
        first = false;
        Duration up = start.elapsed();
        i64 now_ms = up.as_millis();

        // Resize tracking: fullscreen follows both dims, inline only width
        // (its height is reserved, not terminal-sized).
        Result<TermSize, Error> sz = term_get_size(0);
        if (sz.is_ok()) {
            TermSize s = sz.unwrap();
            if (s.cols > 0 && s.rows > 0) {
                bool wide = s.cols != (i64)t.area.width;
                bool tall = !inline_mode && s.rows != (i64)t.area.height;
                if (wide || tall) {
                    i64 rows = s.rows;
                    if (inline_mode) {
                        rows = (i64)t.area.height;
                    }
                    t.resize(s.cols, rows);
                    t.clear();
                    activity = true;
                }
            }
        }

        // Drain available input bytes. EOF quits; EAGAIN means drained.
        // A per-pass byte cap keeps a firehose (pasted megabytes) from
        // starving the tick/draw phases; the next poll returns instantly
        // while bytes remain. Unparsed escape-sequence bytes keep the
        // sequence open so the ESC quiet window can resolve a lone ESC.
        i64 drained = 0;
        while (drained < 256) {
            u8 byte = 0;
            Result<i64, Error> r = try_read(0, &byte, 1);
            if (r.is_err()) {
                if (r.err_is(EAGAIN)) {
                    break;
                }
                // EINTR and friends: retry the read.
                continue;
            }
            if (r.value() == 0) {
                quit = true;
                break;
            }
            drained = drained + 1;
            last_byte = now();
            Optional<KeyEvent> o = keys.feed(byte);
            if (o.is_none()) {
                seq_open = true;
                continue;
            }
            seq_open = false;
            KeyEvent e = o.unwrap();
            activity = true;
            bool qr = app.on_key(&e);
            if (qr) {
                quit = true;
                break;
            }
        }

        // Lone ESC resolves after a quiet window.
        if (!quit && seq_open) {
            Duration quiet = last_byte.elapsed();
            if (quiet.as_millis() >= ESC_TIMEOUT_MS) {
                seq_open = false;
                Optional<KeyEvent> oe = keys.flush();
                if (!oe.is_none()) {
                    KeyEvent e2 = oe.unwrap();
                    activity = true;
                    bool qr2 = app.on_key(&e2);
                    if (qr2) {
                        quit = true;
                    }
                }
            }
        }

        // Tick hook: fire when the monotonic deadline passes.
        if (!quit) {
            i64 interval = app.tick_ms();
            if (interval > 0 && now_ms >= next_tick) {
                i64 dt = now_ms - last_tick_fire;
                if (dt <= 0) {
                    dt = interval;
                }
                last_tick_fire = now_ms;
                next_tick = now_ms + interval;
                app.on_tick(dt);
                activity = true;
            }
        }

        if (activity && !quit) {
            Frame f = t.frame();
            focus_clear();
            app.render(&f);
            t.flush();
            i64 focus_x = 0;
            i64 focus_y = 0;
            if (focus_take(&focus_x, &focus_y)) {
                t.place_cursor(focus_x, focus_y);
                cursor_shown = true;
            } else if (cursor_shown) {
                t.hide_cursor();
                cursor_shown = false;
            }
        }
        if (quit) {
            break;
        }

        // Block until the next due thing: input bytes, the tick deadline,
        // the ESC quiet window, or the idle cap (resize pickup for
        // tick-less apps). A poll error (EINTR) just re-evaluates.
        Duration up2 = start.elapsed();
        i64 wait_from = up2.as_millis();
        i64 timeout = IDLE_POLL_MS;
        i64 interval2 = app.tick_ms();
        if (interval2 > 0 && next_tick > wait_from && next_tick - wait_from < timeout) {
            timeout = next_tick - wait_from;
        }
        if (seq_open) {
            Duration quiet = last_byte.elapsed();
            i64 esc_wait = ESC_TIMEOUT_MS - quiet.as_millis();
            if (esc_wait < 0) {
                esc_wait = 0;
            }
            if (esc_wait < timeout) {
                timeout = esc_wait;
            }
        }
        pfd.revents = 0;
        Result<i64, Error> pr = try_poll(&pfd, 1, timeout);
        if (pr.is_err()) {
            continue;
        }
    }

    if (!inline_mode) {
        term_exit_alt(&STDOUT);
    } else {
        t.exit_inline();
    }
    term_sgr_reset(&STDOUT);
    t.show_cursor();
    STDOUT.flush();
    if (restd) {
        try_fcntl(0, F_SETFL, saved_flags);
    }
}
