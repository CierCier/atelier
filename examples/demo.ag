// Atelier showcase: every component on display, driven by the App runner.
// Run from a real terminal: `agc run --no-cache examples/demo.ag`
// (`--inline` runs in a 12-row scrollback region instead of alt-screen).
// Tabs 1/2/3 (or Left/Right): Widgets, Text, State. j/k + arrows navigate.
// F5 saves the list snapshot, F8 restores it. q quits.
// b toggles a one-frame flash for the region changed by an update.
// Animations poll constantly (100ms ticks); p play/pauses, u steps one frame
// while paused (or nudges forward while playing), t cycles the theme.
import atelier;
import std.args;
import std.term;
import std.mem.alloc;

struct Showcase {
    List items;
    ListState picked;
    i64 tab;
    String hint;
    String snap_status;
    i64 ticks;
    bool playing;
    i64 theme;
    bool blink_enabled;
    bool blink_pending;
    u8 blink_mask;
    Rect blink_header;
    Rect blink_content;
    Rect blink_footer;
    Rect blink_list;
    Rect blink_preview;
}

const u8 FLASH_HEADER = 1;
const u8 FLASH_LIST = 2;
const u8 FLASH_PREVIEW = 4;
const u8 FLASH_CONTENT = 8;
const u8 FLASH_FOOTER = 16;

// One preview surface owns the selected app component. Selection changes touch
// one list and one right-hand rectangle, while Terminal.diff() limits the
// bytes sent to the terminal.
struct PreviewTheme {
    str name;
    Style frame;
    Style accent;
    Style body;
    Style muted;
}

const i64 THEME_COUNT = 3;

PreviewTheme preview_theme(i64 index) {
    i64 pick = index % THEME_COUNT;
    if (pick < 0) {
        pick = pick + THEME_COUNT;
    }
    PreviewTheme t;
    if (pick == 1) {
        t.name = "TOKYO NIGHT";
        t.frame = Style.new().fg(Color.Rgb((u8)86, (u8)95, (u8)122));
        t.accent = Style.new().fg(Color.Rgb((u8)122, (u8)162, (u8)247)).bold();
        t.body = Style.new().fg(Color.Rgb((u8)197, (u8)200, (u8)198)).bg(Color.Rgb((u8)26, (u8)27, (u8)38));
        t.muted = Style.new().fg(Color.Rgb((u8)158, (u8)206, (u8)106)).bg(Color.Rgb((u8)26, (u8)27, (u8)38));
        return t;
    }
    if (pick == 2) {
        t.name = "DRACULA";
        t.frame = Style.new().fg(Color.Rgb((u8)68, (u8)71, (u8)90));
        t.accent = Style.new().fg(Color.Rgb((u8)189, (u8)147, (u8)249)).bold();
        t.body = Style.new().fg(Color.Rgb((u8)248, (u8)248, (u8)242)).bg(Color.Rgb((u8)40, (u8)42, (u8)54));
        t.muted = Style.new().fg(Color.Rgb((u8)80, (u8)250, (u8)123)).bg(Color.Rgb((u8)40, (u8)42, (u8)54));
        return t;
    }
    t.name = "IBM CARBON";
    t.frame = Style.new().fg(Color.Rgb((u8)82, (u8)82, (u8)82));
    t.accent = Style.new().fg(Color.Rgb((u8)15, (u8)98, (u8)254)).bold();
    t.body = Style.new().fg(Color.Rgb((u8)244, (u8)244, (u8)244)).bg(Color.Rgb((u8)22, (u8)22, (u8)22));
    t.muted = Style.new().fg(Color.Rgb((u8)66, (u8)190, (u8)101)).bg(Color.Rgb((u8)22, (u8)22, (u8)22));
    return t;
}

str component_name(i64 index) {
    if (index == 0) { return "Buffer"; }
    if (index == 1) { return "Layout"; }
    if (index == 2) { return "Style"; }
    if (index == 3) { return "Text"; }
    if (index == 4) { return "Block"; }
    if (index == 5) { return "Paragraph"; }
    if (index == 6) { return "List"; }
    if (index == 7) { return "Terminal"; }
    if (index == 8) { return "Tabs"; }
    if (index == 9) { return "Gauge"; }
    if (index == 10) { return "Sparkline"; }
    if (index == 11) { return "BarChart"; }
    if (index == 12) { return "Spinner"; }
    if (index == 13) { return "Table"; }
    if (index == 14) { return "Scrollbar"; }
    if (index == 15) { return "Tree"; }
    if (index == 16) { return "TextInput"; }
    if (index == 17) { return "DiffView"; }
    if (index == 18) { return "KittScanner"; }
    if (index == 19) { return "LineGauge"; }
    if (index == 20) { return "LineChart"; }
    if (index == 21) { return "StatusBar"; }
    if (index == 22) { return "Clear"; }
    if (index == 23) { return "HRule"; }
    if (index == 24) { return "Canvas"; }
    if (index == 25) { return "Checklist"; }
    if (index == 26) { return "Log"; }
    if (index == 27) { return "Toasts"; }
    if (index == 28) { return "Calendar"; }
    return "Buffer";
}

Vec<ListItem> showcase_items() {
    Vec<ListItem> v = Vec<ListItem>.new();
    v.push(ListItem.new("Buffer — retained cell grid"));
    v.push(ListItem.new("Layout — constraint solver"));
    v.push(ListItem.new("Style — colors and modifiers"));
    v.push(ListItem.new("Text — spans and wrapping"));
    v.push(ListItem.new("Block — borders and titles"));
    v.push(ListItem.new("Paragraph — reflowed prose"));
    v.push(ListItem.new("List — this widget"));
    v.push(ListItem.new("Terminal — diffed output"));
    v.push(ListItem.new("Tabs — horizontal selector"));
    v.push(ListItem.new("Gauge — progress meter"));
    v.push(ListItem.new("Sparkline — compact trend"));
    v.push(ListItem.new("BarChart — horizontal bars"));
    v.push(ListItem.new("Spinner — loading state"));
    v.push(ListItem.new("Table — columns + selection"));
    v.push(ListItem.new("Scrollbar — position gutter"));
    v.push(ListItem.new("Tree — expandable hierarchy"));
    v.push(ListItem.new("TextInput — editor state"));
    v.push(ListItem.new("DiffView — review lines"));
    v.push(ListItem.new("KittScanner — status sweep"));
    v.push(ListItem.new("LineGauge — hairline meter"));
    v.push(ListItem.new("LineChart — axes + series"));
    v.push(ListItem.new("StatusBar — key hints"));
    v.push(ListItem.new("Clear — popup overlay"));
    v.push(ListItem.new("HRule — divider"));
    v.push(ListItem.new("Canvas — shapes + markers"));
    v.push(ListItem.new("Checklist — multi-select"));
    v.push(ListItem.new("Log — level filter"));
    v.push(ListItem.new("Toasts — expiring notes"));
    v.push(ListItem.new("Calendar — month grid"));
    return move v;
}

impl App for Showcase {
    void init(&mut self) {
        self.tab = 0;
        self.ticks = 0;
        self.playing = true;
        self.theme = 0;
        self.picked.select(0);
        self.blink_pending = false;
    }

    void mark_updated(&mut self, u8 target) {
        self.blink_mask = self.blink_mask | target;
        self.blink_pending = true;
    }

    void set_snap_status(&mut self, str status) {
        self.snap_status.drop();
        self.snap_status = String.from_str(status);
    }

    bool on_key(&mut self, &KeyEvent e) {
        i64 act = match e.kind {
            Up : 1,
            Down : 2,
            Left : 3,
            Right : 4,
            Char : 5,
            FKey : 6,
            _ : 0,
        };
        if (act == 1) {
            self.picked.select(self.picked.selected - 1);
        } else if (act == 2) {
            self.picked.select(self.picked.selected + 1);
        } else if (act == 3) {
            self.tab = self.tab - 1;
            if (self.tab < 0) {
                self.tab = 2;
            }
        } else if (act == 4) {
            self.tab = self.tab + 1;
            if (self.tab > 2) {
                self.tab = 0;
            }
        } else if (act == 5) {
            u32 cp = e.codepoint;
            if (cp == (u32)113 || e.ctrl) {
                return true; // 'q' or any ctrl combo
            }
            if (cp == (u32)106) {
                self.picked.select(self.picked.selected + 1);
            }
            if (cp == (u32)107) {
                self.picked.select(self.picked.selected - 1);
            }
            if (cp == (u32)49) {
                self.tab = 0;
            }
            if (cp == (u32)50) {
                self.tab = 1;
            }
            if (cp == (u32)51) {
                self.tab = 2;
            }
            if (cp == (u32)98) {
                self.blink_enabled = !self.blink_enabled;
            }
            if (cp == (u32)112) {
                self.playing = !self.playing;
            }
            if (cp == (u32)116) {
                self.theme = (self.theme + 1) % THEME_COUNT;
            }
            if (cp == (u32)117) {
                self.ticks = self.ticks + 1;
            }
        } else if (act == 6) {
            if (e.fnum == 5) {
                str snap = @json(self.picked);
                if (store_save("/tmp/atelier-showcase.json", snap)) {
                    self.set_snap_status("saved");
                } else {
                    self.set_snap_status("save FAILED");
                }
                free((void*)snap);
            }
            if (e.fnum == 8) {
                Result<String, Error> r = store_load("/tmp/atelier-showcase.json");
                if (r.is_err()) {
                    self.set_snap_status("no snapshot");
                } else {
                    String content = r.unwrap();
                    str text = content.to_str();
                    Result<ListState, JsonError> back = @from_json(ListState, text);
                    content.drop();
                    if (back.is_err()) {
                        self.set_snap_status("snapshot corrupt");
                    } else {
                        ListState restored = back.unwrap();
                        self.picked.select(restored.selected);
                        self.picked.offset = restored.offset;
                        self.set_snap_status("restored");
                    }
                }
            }
        }
        if (act != 0) {
            self.mark_updated(FLASH_FOOTER);
        }
        if (act == 1 || act == 2 || (act == 5 && (e.codepoint == (u32)106 || e.codepoint == (u32)107))) {
            if (self.tab == 0) {
                self.mark_updated(FLASH_LIST);
                self.mark_updated(FLASH_PREVIEW);
            }
        } else if (act == 3 || act == 4 || (act == 5 && (e.codepoint == (u32)49 || e.codepoint == (u32)50 || e.codepoint == (u32)51))) {
            self.mark_updated(FLASH_HEADER);
            self.mark_updated(FLASH_CONTENT);
        } else if (act == 5 && (e.codepoint == (u32)112 || e.codepoint == (u32)117)) {
            self.mark_updated(FLASH_PREVIEW);
            self.mark_updated(FLASH_FOOTER);
            if (self.tab == 2) {
                self.mark_updated(FLASH_CONTENT);
            }
        } else if (act == 5 && e.codepoint == (u32)116) {
            self.mark_updated(FLASH_HEADER);
            self.mark_updated(FLASH_LIST);
            self.mark_updated(FLASH_PREVIEW);
            self.mark_updated(FLASH_CONTENT);
            self.mark_updated(FLASH_FOOTER);
        } else if (act == 6) {
            if (e.fnum == 8 && self.tab == 0) {
                self.mark_updated(FLASH_LIST);
                self.mark_updated(FLASH_PREVIEW);
            }
            if (e.fnum == 8 && self.tab == 2) {
                self.mark_updated(FLASH_CONTENT);
            }
        }
        self.hint.clear();
        self.hint.push_str("last: ");
        self.hint.push_str(key_action_name(act));
        return false;
    }

    void on_tick(&mut self, i64 _dt_ms) {
        // Constant polling drives the animations; p pauses, u steps once.
        if (self.playing) {
            self.ticks = self.ticks + 1;
            self.mark_updated(FLASH_PREVIEW);
            self.mark_updated(FLASH_FOOTER);
            if (self.tab == 2) {
                self.mark_updated(FLASH_CONTENT);
            }
        }
    }

    void render(&mut self, &mut Frame f) {
        Rect area = f.area;
        Vec<Constraint> vcs = Vec<Constraint>.new();
        vcs.push(Constraint.Length((u16)3));
        vcs.push(Constraint.Fill((u16)1));
        vcs.push(Constraint.Length((u16)1));
        Layout outer = Layout.new(Direction.Vertical, move vcs);
        Vec<Rect> rows = outer.split(area);
        Rect* header_ptr = rows.get_ptr((i64)0);
        Rect* content_ptr = rows.get_ptr((i64)1);
        Rect* footer_ptr = rows.get_ptr((i64)2);
        self.blink_header = *header_ptr;
        self.blink_content = *content_ptr;
        self.blink_footer = *footer_ptr;
        self.render_tabs(f.buf, rows.get_ptr((i64)0));
        if (self.tab == 0) {
            self.render_widgets(f.buf, rows.get_ptr((i64)1));
        } else if (self.tab == 1) {
            self.render_text(f.buf, rows.get_ptr((i64)1));
        } else {
            self.render_state(f.buf, rows.get_ptr((i64)1));
        }
        self.render_bar(f.buf, rows.get_ptr((i64)2));
        self.apply_blink(f.buf);
    }

    i64 tick_ms(&self) {
        return 100;
    }
}

str key_action_name(i64 act) {
    if (act == 1) {
        return "up";
    }
    if (act == 2) {
        return "down";
    }
    if (act == 3) {
        return "left";
    }
    if (act == 4) {
        return "right";
    }
    if (act == 5) {
        return "char";
    }
    if (act == 6) {
        return "fkey";
    }
    return "other";
}

i64 pulse_value(i64 tick, i64 phase, i64 max) {
    i64 period = 20;
    i64 half = period / 2;
    i64 position = (tick + phase) % period;
    if (position > half) {
        position = period - position;
    }
    return position * max / half;
}

/// Manual `u` presses simulate 100ms of elapsed time. Each preview chooses
/// its own cadence, so changing a widget interval changes its visible rate.
i64 update_frame(i64 updates, i64 interval_ms) {
    if (interval_ms <= 0) {
        return updates;
    }
    return updates * 100 / interval_ms;
}

impl Showcase {
    PreviewTheme current_theme(&self) {
        return preview_theme(self.theme);
    }

    void render_tabs(&self, &mut Buffer buf, &Rect area) {
        PreviewTheme theme = self.current_theme();
        Text head = Text.from(" Atelier showcase");
        Paragraph hp = Paragraph.new(move head).block(
            Block.new().title(" ratatui-grade TUI in Silver ").title_style(theme.accent).border_style(theme.frame)
        );
        hp.render(area, buf);

        // Tab bar on the last header row.
        i64 bx = (i64)area.x + 2;
        i64 by = (i64)area.y + (i64)area.height - 1;
        if (by <= (i64)area.y) {
            return;
        }
        str names[3] = { "1 Widgets", "2 Text", "3 State" };
        for (i64 i = 0; i < 3; i = i + 1) {
            Style st = Style.new();
            if (i == self.tab) {
                st = Style.new().reversed().bold();
            }
            buf.set_string(bx, by, names[i], st, 12);
            bx = bx + 12;
        }
    }

    void render_widgets(&mut self, &mut Buffer buf, &Rect area) {
        PreviewTheme theme = self.current_theme();
        Vec<Constraint> hcs = Vec<Constraint>.new();
        hcs.push(Constraint.Percentage((u16)40));
        hcs.push(Constraint.Fill((u16)1));
        Layout body = Layout.new(Direction.Horizontal, move hcs);
        Vec<Rect> cols = body.split(*area);
        Rect* lr = cols.get_ptr((i64)0);
        Rect* dr = cols.get_ptr((i64)1);

        Vec<Constraint> lcs = Vec<Constraint>.new();
        lcs.push(Constraint.Fill((u16)1));
        lcs.push(Constraint.Length((u16)5));
        Layout left = Layout.new(Direction.Vertical, move lcs);
        Vec<Rect> lrows = left.split(*lr);
        Rect* list_ptr = lrows.get_ptr((i64)0);
        self.blink_list = *list_ptr;
        self.blink_preview = *dr;
        self.items.highlight_style = theme.accent;
        self.items.render(lrows.get_ptr((i64)0), buf, &self.picked);

        // Block border variants, live.
        Block plain = Block.new().title(" plain ").border_style(theme.frame);
        plain.render(lrows.get_ptr((i64)1), buf);

        self.render_previews(buf, dr);
    }

    void apply_blink(&mut self, &mut Buffer buf) {
        if (self.blink_enabled && self.blink_pending) {
            Style flash = Style.new().reversed().bold();
            if ((self.blink_mask & FLASH_HEADER) != (u8)0) {
                buf.set_style(self.blink_header, flash);
            }
            if ((self.blink_mask & FLASH_LIST) != (u8)0) {
                buf.set_style(self.blink_list, flash);
            }
            if ((self.blink_mask & FLASH_PREVIEW) != (u8)0) {
                buf.set_style(self.blink_preview, flash);
            }
            if ((self.blink_mask & FLASH_CONTENT) != (u8)0) {
                buf.set_style(self.blink_content, flash);
            }
            if ((self.blink_mask & FLASH_FOOTER) != (u8)0) {
                buf.set_style(self.blink_footer, flash);
            }
        }
        self.blink_pending = false;
        self.blink_mask = (u8)0;
    }

    // The preview shell and card take the active theme; the sample itself
    // receives the theme accent/body/muted so `t` recolors the whole system.
    void render_previews(&self, &mut Buffer buf, &Rect area) {
        PreviewTheme theme = self.current_theme();
        Block shell = Block.new().title(" live app preview · p play/pause · t theme ").border_style(theme.frame);
        shell.render(area, buf);
        Rect inner = shell.inner(*area);

        Vec<Constraint> sections = Vec<Constraint>.new();
        sections.push(Constraint.Length((u16)1));
        sections.push(Constraint.Fill((u16)1));
        Layout header_layout = Layout.new(Direction.Vertical, move sections);
        Vec<Rect> header_rows = header_layout.split(inner);
        String label = @format("component: {}", component_name(self.picked.selected));
        buf.set_string((i64)inner.x, (i64)inner.y, label.to_str(), Style.new().bold(), (i64)inner.width);
        label.drop();

        Rect* card_area = header_rows.get_ptr((i64)1);
        Block frame = Block.new().title(theme.name).border_style(theme.frame);
        frame.render(card_area, buf);
        Rect content = frame.inner(*card_area);
        buf.set_style(content, theme.body);
        render_preview_sample(buf, &content, self.picked.selected, self.ticks, theme.accent, theme.body, theme.muted);
    }

}

    // Draw the selected component directly into the preview. The examples use
    // realistic app data while the 100ms poll advances their live state.
void render_preview_sample(
        &mut Buffer buf,
        &Rect area,
        i64 selected,
        i64 ticks,
        Style accent,
        Style body,
        Style muted,
    ) {
        i64 x = (i64)area.x;
        i64 y = (i64)area.y;
        i64 w = (i64)area.width;
        i64 h = (i64)area.height;
        if (w <= 0 || h <= 0) {
            return;
        }
        if (selected == 0) {
            Block stream = Block.new().title("event stream").border_style(accent).update_interval(250);
            stream.render(area, buf);
            Rect inner = stream.inner(*area);
            i64 frame = update_frame(ticks, stream.update_interval_ms());
            String event = @format("[{}] worker finished job #{}", frame % 10, 100 + frame % 20);
            buf.set_string((i64)inner.x, (i64)inner.y, event.to_str(), accent, (i64)inner.width);
            event.drop();
            if (inner.height > (u16)1) {
                buf.set_string((i64)inner.x, (i64)inner.y + 1, "buffer: 3 changed cells", muted, (i64)inner.width);
            }
            if (inner.height > (u16)2) {
                buf.set_string((i64)inner.x, (i64)inner.y + 2, "diff: only dirty cells flushed", body, (i64)inner.width);
            }
        } else if (selected == 1) {
            Vec<Constraint> columns = Vec<Constraint>.new();
            columns.push(Constraint.Length((u16)14));
            columns.push(Constraint.Fill((u16)1));
            columns.push(Constraint.Length((u16)14));
            Layout dashboard = Layout.new(Direction.Horizontal, move columns);
            Vec<Rect> panes = dashboard.split(*area);
            Block queue = Block.new().title("queue");
            Block agent = Block.new().title("agent").update_interval(300);
            Block output = Block.new().title("output");
            i64 frame = update_frame(ticks, agent.update_interval_ms());
            queue.render(panes.get_ptr(0), buf);
            agent.render(panes.get_ptr(1), buf);
            output.render(panes.get_ptr(2), buf);
            String queue_label = @format("{} jobs", 3 + frame % 3);
            buf.set_string((i64)panes.get_ptr(0).x + 1, (i64)panes.get_ptr(0).y + 1, queue_label.to_str(), muted, 12);
            queue_label.drop();
            buf.set_string((i64)panes.get_ptr(1).x + 1, (i64)panes.get_ptr(1).y + 1, "running", accent, 12);
            buf.set_string((i64)panes.get_ptr(2).x + 1, (i64)panes.get_ptr(2).y + 1, "live", body, 12);
        } else if (selected == 2) {
            Style ok = Style.new().fg(Color.Green).bold();
            Style warn = Style.new().fg(Color.Yellow).bold();
            Style info = Style.new().fg(Color.Cyan);
            buf.set_string(x, y, "● READY    ● RUNNING    ● WARNING", body, w);
            if (h > 1) { buf.set_string(x, y + 1, "build complete", ok, w); }
            if (h > 2) { buf.set_string(x, y + 2, "indexing files", info, w); }
            if (h > 3) { buf.set_string(x, y + 3, "cache is cold", warn, w); }
        } else if (selected == 3) {
            String chat = @format("assistant  ·  build report\nThe workspace is ready.\nUpdate #{} is clean.", update_frame(ticks, 500));
            Text sample_text = Text.from(chat.to_str());
            Paragraph sample = Paragraph.new(move sample_text).style(body).block(Block.new().title("chat message")).update_interval(500);
            sample.render(area, buf);
            chat.drop();
        } else if (selected == 5) {
            Text sample_text = Text.from("$ agc check\nchecking imports and ownership\nchecking 16 integration tests\nfinished successfully");
            Paragraph sample = Paragraph.new(move sample_text).style(body).block(Block.new().title("compiler output")).scroll((u16)0, (u16)update_frame(ticks, 200) % 2).update_interval(200);
            sample.render(area, buf);
        } else if (selected == 4) {
            Vec<Constraint> brows = Vec<Constraint>.new();
            brows.push(Constraint.Fill((u16)1));
            brows.push(Constraint.Fill((u16)1));
            Layout bgrid = Layout.new(Direction.Vertical, move brows);
            Vec<Rect> bhalves = bgrid.split(*area);
            Rect* btop_half = bhalves.get_ptr((i64)0);
            Rect* bbot_half = bhalves.get_ptr((i64)1);
            Vec<Constraint> bcols = Vec<Constraint>.new();
            bcols.push(Constraint.Fill((u16)1));
            bcols.push(Constraint.Fill((u16)1));
            Layout btop = Layout.new(Direction.Horizontal, move bcols);
            Vec<Rect> top_cells = btop.split(*btop_half);
            Vec<Constraint> bcols2 = Vec<Constraint>.new();
            bcols2.push(Constraint.Fill((u16)1));
            bcols2.push(Constraint.Fill((u16)1));
            Layout bbottom = Layout.new(Direction.Horizontal, move bcols2);
            Vec<Rect> bot_cells = bbottom.split(*bbot_half);
            Block rounded = Block.new().title(" rounded ").border_type(BorderType.Rounded).border_style(accent);
            rounded.render(top_cells.get_ptr((i64)0), buf);
            Block doubled = Block.new().title(" double + shadow ").border_type(BorderType.Double).border_style(accent).shadow(muted);
            doubled.render(top_cells.get_ptr((i64)1), buf);
            Block bottomed = Block.new().title(" bottom title ").title_position(TitlePosition.Bottom).border_style(accent);
            bottomed.render(bot_cells.get_ptr((i64)0), buf);
            Block artifacts = Block.new().title("build artifacts").border_style(accent).padding((u16)1).update_interval(400);
            Rect* art_area = bot_cells.get_ptr((i64)1);
            artifacts.render(art_area, buf);
            Rect inner = artifacts.inner(*art_area);
            i64 frame = update_frame(ticks, artifacts.update_interval_ms());
            buf.set_string((i64)inner.x, (i64)inner.y, "agc  0.1.0", body, (i64)inner.width);
            if (inner.height > (u16)1) { buf.set_string((i64)inner.x, (i64)inner.y + 1, "demo  executable", accent, (i64)inner.width); }
            if (inner.height > (u16)2) {
                String tests = @format("tests  {} passed", 16 + frame % 2);
                buf.set_string((i64)inner.x, (i64)inner.y + 2, tests.to_str(), muted, (i64)inner.width);
                tests.drop();
            }
        } else if (selected == 6) {
            Vec<ListItem> items = Vec<ListItem>.new();
            items.push(ListItem.styled("Open file", body));
            items.push(ListItem.styled("Run tests", body));
            items.push(ListItem.styled("Search symbols", body));
            items.push(ListItem.styled("Quit", body));
            List sample = List.new(move items).highlight_symbol("> ").highlight_style(accent).block(Block.new().title("command palette")).update_interval(300);
            ListState state = ListState.new();
            state.select(update_frame(ticks, sample.update_interval_ms()) % 4);
            sample.render(area, buf, &state);
        } else if (selected == 7) {
            String output = @format("$ agc run demo.ag\nupdate #{}\n{} cells written", update_frame(ticks, 150), 1 + update_frame(ticks, 150) % 5);
            Text terminal_text = Text.from(output.to_str());
            Paragraph terminal = Paragraph.new(move terminal_text).style(body).block(Block.new().title("terminal")).update_interval(150);
            terminal.render(area, buf);
            output.drop();
        } else if (selected == 8) {
            Vec<TabItem> tab_items = Vec<TabItem>.new();
            tab_items.push(TabItem.new("Overview"));
            tab_items.push(TabItem.new("Jobs"));
            tab_items.push(TabItem.new("Logs"));
            Tabs tabs = Tabs.new(move tab_items).selected_style(accent).block(Block.new().title("agent workspace")).update_interval(300);
            TabsState tab_state = TabsState.new();
            tab_state.select(update_frame(ticks, tabs.update_interval_ms()) % 3);
            tabs.render(area, buf, &tab_state);
        } else if (selected == 9) {
            Gauge gauge = Gauge.new().label("compile").filled_style(accent).block(Block.new().title("build progress")).update_interval(200);
            i64 percent = pulse_value(update_frame(ticks, gauge.update_interval_ms()), 0, 100);
            gauge = gauge.percent((u16)percent);
            gauge.render(area, buf);
        } else if (selected == 10) {
            Vec<u16> values = Vec<u16>.new();
            Sparkline spark = Sparkline.new(move values).max_value((u16)100).style(accent).block(Block.new().title("CPU / 60s")).update_interval(150);
            i64 frame = update_frame(ticks, spark.update_interval_ms());
            spark.values.push((u16)pulse_value(frame, 0, 100));
            spark.values.push((u16)pulse_value(frame, 3, 100));
            spark.values.push((u16)pulse_value(frame, 6, 100));
            spark.values.push((u16)pulse_value(frame, 9, 100));
            spark.values.push((u16)pulse_value(frame, 12, 100));
            spark.render(area, buf);
        } else if (selected == 11) {
            Vec<BarItem> bar_items = Vec<BarItem>.new();
            BarChart chart = BarChart.new(move bar_items).max_value((u16)100).bar_style(accent).block(Block.new().title("resource usage")).update_interval(200);
            i64 frame = update_frame(ticks, chart.update_interval_ms());
            chart.items.push(BarItem.new("cpu", (u16)pulse_value(frame, 0, 100)));
            chart.items.push(BarItem.new("memory", (u16)pulse_value(frame, 5, 100)));
            chart.items.push(BarItem.new("disk", (u16)pulse_value(frame, 10, 100)));
            chart.render(area, buf);
        } else if (selected == 12) {
            Block status = Block.new().title("background task");
            status.render(area, buf);
            Rect inner = status.inner(*area);
            Spinner spinner = Spinner.new("indexing project").style(accent).update_interval(80);
            spinner.advance(ticks * 100);
            spinner.render(&inner, buf);
        } else if (selected == 13) {
            Vec<TableRow> table_rows = Vec<TableRow>.new();
            Vec<TableCell> head = Vec<TableCell>.new();
            head.push(TableCell.new("FILE"));
            head.push(TableCell.new("STATE"));
            table_rows.push(TableRow.new(move head));
            Vec<TableCell> data = Vec<TableCell>.new();
            data.push(TableCell.new("main.ag"));
            if (ticks % 2 == 0) {
                data.push(TableCell.new("building"));
            } else {
                data.push(TableCell.new("clean"));
            }
            table_rows.push(TableRow.new(move data));
            Vec<TableCell> second = Vec<TableCell>.new();
            second.push(TableCell.new("demo.ag"));
            if (ticks % 2 == 0) {
                second.push(TableCell.new("queued"));
            } else {
                second.push(TableCell.new("ready"));
            }
            table_rows.push(TableRow.new(move second));
            Vec<TableCell> foot = Vec<TableCell>.new();
            foot.push(TableCell.new("3 files"));
            if (ticks % 2 == 0) {
                foot.push(TableCell.new("1 building"));
            } else {
                foot.push(TableCell.new("all clean"));
            }
            Table table = Table.new(move table_rows).header_rows((u16)1).selected_style(accent).column_spacing((u16)1).footer(move foot).block(Block.new().title("job queue")).update_interval(250);
            TableState table_state = TableState.new();
            table_state.select(1 + update_frame(ticks, table.update_interval_ms()) % 2);
            table.render(area, buf, &table_state);
        } else if (selected == 14) {
            Vec<Constraint> columns = Vec<Constraint>.new();
            columns.push(Constraint.Fill((u16)1));
            columns.push(Constraint.Length((u16)1));
            Layout log_layout = Layout.new(Direction.Horizontal, move columns);
            Vec<Rect> log_parts = log_layout.split(*area);
            Rect* log_area = log_parts.get_ptr(0);
            Rect* scroll_area = log_parts.get_ptr(1);
            Block log_panel = Block.new().title("build log");
            log_panel.render(log_area, buf);
            Rect log_inner = log_panel.inner(*log_area);
            Text log_text = Text.from("[00:01] resolving imports\n[00:02] parsing atelier.ag\n[00:03] checking ownership\n[00:04] checking widgets\n[00:05] compiling buffer.ag\n[00:06] compiling table.ag\n[00:07] linking demo\n[00:08] running tests\n[00:09] block_test passed\n[00:10] table_test passed\n[00:11] terminal_test passed\n[00:12] all checks passed\n[00:13] waiting for changes\n[00:14] watching files\n[00:15] ready\n[00:16] watching source files\n[00:17] rebuilding changed module\n[00:18] refreshing diagnostics\n[00:19] no errors found\n[00:20] waiting for changes\n[00:21] watching source files\n[00:22] idle\n[00:23] idle\n[00:24] ready");
            Scrollbar bar = Scrollbar.new().thumb_style(accent).update_interval(120);
            i64 scroll = update_frame(ticks, bar.update_interval_ms()) % 12;
            Rect log_text_area = log_inner;
            bool show_hbar = (i64)log_inner.height > 2;
            if (show_hbar) {
                log_text_area.height = (u16)((i64)log_text_area.height - 1);
            }
            Paragraph log = Paragraph.new(move log_text).wrap(false).scroll((u16)0, (u16)scroll).style(muted);
            log.render(&log_text_area, buf);
            ScrollbarState bar_state = ScrollbarState.new(24);
            bar_state.set_position(scroll);
            bar.render(scroll_area, buf, &bar_state);
            // Horizontal twin on its own bottom row of the log panel.
            if (show_hbar) {
                Scrollbar hbar = Scrollbar.new().orientation(ScrollbarOrientation.Horizontal).thumb_style(accent).end_symbols("◀", "▶");
                ScrollbarState hbar_state = ScrollbarState.new(24);
                hbar_state.set_position(scroll);
                Rect hbar_area = Rect.new(log_inner.x, (u16)((i64)log_inner.y + (i64)log_inner.height - 1), log_inner.width, (u16)1);
                hbar.render(&hbar_area, buf, &hbar_state);
            }
        } else if (selected == 15) {
            Vec<TreeItem> tree_items = Vec<TreeItem>.new();
            tree_items.push(TreeItem.new("src", (u16)0, true));
            tree_items.push(TreeItem.new("atelier.ag", (u16)1, false));
            tree_items.push(TreeItem.new("widgets", (u16)1, true));
            tree_items.push(TreeItem.new("table.ag", (u16)2, false));
            tree_items.push(TreeItem.new("tests", (u16)0, true));
            tree_items.push(TreeItem.new("demo_test.ag", (u16)1, false));
            Tree tree = Tree.new(move tree_items).highlight_style(accent).block(Block.new().title("project files")).update_interval(500);
            i64 frame = update_frame(ticks, tree.update_interval_ms());
            TreeItem* root = tree.items.get_ptr(0);
            root.expanded = (frame % 8) < 5;
            TreeItem* widgets = tree.items.get_ptr(2);
            widgets.expanded = (frame % 6) < 4;
            TreeState tree_state = TreeState.new();
            if (root.expanded) {
                tree_state.select(1);
            } else {
                tree_state.select(0);
            }
            tree.render(area, buf, &tree_state);
        } else if (selected == 16) {
            Vec<Constraint> irows = Vec<Constraint>.new();
            irows.push(Constraint.Fill((u16)1));
            irows.push(Constraint.Fill((u16)1));
            Layout ilayout = Layout.new(Direction.Vertical, move irows);
            Vec<Rect> ihalves = ilayout.split(*area);
            TextInput input = TextInput.new().prompt("search: ").placeholder("type a file name").cursor_style(accent.reversed()).focused(true).block(Block.new().title("file finder")).update_interval(100);
            TextInputState input_state = TextInputState.from("widgets/table.ag");
            input_state.cursor = update_frame(ticks, input.update_interval_ms()) % (input_state.value.len() + 1);
            input.render(ihalves.get_ptr((i64)0), buf, &input_state);
            TextInput secret = TextInput.new().prompt("password: ").mask(true).cursor_style(accent.reversed()).block(Block.new().title("sign in")).update_interval(100);
            TextInputState secret_state = TextInputState.from("s3cr3t");
            secret_state.cursor = update_frame(ticks, secret.update_interval_ms()) % (secret_state.value.len() + 1);
            secret.render(ihalves.get_ptr((i64)1), buf, &secret_state);
        } else if (selected == 17) {
            Vec<DiffLine> diff_lines = Vec<DiffLine>.new();
            diff_lines.push(DiffLine.new("@@ fn render_frame", DiffKind.Hunk));
            diff_lines.push(DiffLine.new("let frame = terminal.frame();", DiffKind.Context));
            diff_lines.push(DiffLine.new("let full_redraw = true;", DiffKind.Removed));
            if (update_frame(ticks, 500) % 2 == 0) {
                diff_lines.push(DiffLine.new("let dirty_only = true;", DiffKind.Added));
            } else {
                diff_lines.push(DiffLine.new("flush(dirty_cells);", DiffKind.Added));
            }
            DiffView diff = DiffView.new(move diff_lines).added_style(accent).removed_style(muted).block(Block.new().title("code review")).update_interval(500);
            diff.render(area, buf);
        } else if (selected == 18) {
            Text scan_text = Text.from("BUILD READY  ·  WATCHING FILES  ·  P PLAY/PAUSE");
            KittScanner scanner = KittScanner.new(move scan_text, 80)
                .block(Block.new().title("status scanner"))
                .hot_style(accent)
                .trail_style(muted)
                .trail(4);
            scanner.advance(ticks * 100);
            scanner.render(area, buf);
        } else if (selected == 19) {
            LineGauge meter = LineGauge.new().label("index").filled_style(accent).block(Block.new().title("job progress")).update_interval(200);
            i64 frame = update_frame(ticks, meter.update_interval_ms());
            meter = meter.ratio(pulse_value(frame, 0, 100), 100);
            meter.render(area, buf);
        } else if (selected == 20) {
            Vec<ChartSeries> lines = Vec<ChartSeries>.new();
            ChartSeries cpu = ChartSeries.styled("cpu", accent);
            ChartSeries mem = ChartSeries.styled("mem", muted);
            LineChart chart = LineChart.new(move lines).axis_style(muted).show_legend(true).x_labels("t-47", "now").block(Block.new().title("load / 60s")).update_interval(150);
            i64 frame = update_frame(ticks, chart.update_interval_ms());
            for (i64 i = 0; i < 48; i = i + 1) {
                cpu.push(pulse_value(frame + i, 0, 100));
                mem.push(pulse_value(frame + i, 5, 100));
            }
            chart.series.push(move cpu);
            chart.series.push(move mem);
            chart.render(area, buf);
        } else if (selected == 21) {
            StatusBar bar = StatusBar.new()
                .item("q", "quit").item("p", "pause").item("t", "theme").item("u", "step")
                .right_text("live preview");
            bar.key_style = accent;
            bar.right_style = muted;
            Block shell = Block.new().title("key hints");
            shell.render(area, buf);
            Rect inner = shell.inner(*area);
            bar.render(&inner, buf);
        } else if (selected == 22) {
            Fill tint = Fill.new("·").style(muted);
            tint.render(area, buf);
            Text behind_text = Text.from("This paragraph sits behind the popup. Clear erases its cells first so the dialog paints on empty space.");
            Paragraph behind = Paragraph.new(move behind_text).wrap(false).style(muted);
            behind.render(area, buf);
            Rect pop = centered_rect(*area, (u16)34, (u16)7);
            Clear c = Clear.new();
            c.render(&pop, buf);
            Block dialog = Block.new().title(" confirm ").border_style(accent);
            dialog.render(&pop, buf);
            Rect inner = dialog.inner(pop);
            buf.set_string((i64)inner.x, (i64)inner.y, "Rebuild the workspace?", body, (i64)inner.width);
            if (inner.height > (u16)1) {
                buf.set_string((i64)inner.x, (i64)inner.y + 1, "[rebuild]   [cancel]", accent, (i64)inner.width);
            }
        } else if (selected == 23) {
            Block shell = Block.new().title("sections");
            shell.render(area, buf);
            Rect inner = shell.inner(*area);
            Vec<Constraint> rows3 = Vec<Constraint>.new();
            rows3.push(Constraint.Fill((u16)1));
            rows3.push(Constraint.Fill((u16)1));
            rows3.push(Constraint.Fill((u16)1));
            Layout thirds = Layout.new(Direction.Vertical, move rows3);
            Vec<Rect> parts = thirds.split(inner);
            HRule top = HRule.new().label("build").alignment(Alignment.Left);
            top.render(parts.get_ptr((i64)0), buf);
            HRule mid = HRule.new().label("test").alignment(Alignment.Center).style(accent);
            mid.render(parts.get_ptr((i64)1), buf);
            HRule plain = HRule.new();
            plain.render(parts.get_ptr((i64)2), buf);
        } else if (selected == 24) {
            Canvas canvas = Canvas.new().bounds(0, 96, 0, 100).block(Block.new().title("signal")).update_interval(150);
            i64 frame = update_frame(ticks, canvas.update_interval_ms());
            for (i64 i = 0; i < 48; i = i + 1) {
                canvas.point(i * 2, pulse_value(frame + i, 0, 100), accent);
            }
            canvas.line(0, 50, 96, 50, muted);
            canvas.render(area, buf);
        } else if (selected == 25) {
            str names[4] = { "main.ag", "atelier.ag", "demo.ag", "README.md" };
            Checklist cl = Checklist.new(Vec<CheckItem>.new()).check_style(accent).highlight_style(muted.reversed()).block(Block.new().title("stage files")).update_interval(400);
            i64 frame = update_frame(ticks, cl.update_interval_ms());
            for (i64 i = 0; i < 4; i = i + 1) {
                if (((frame / 8) + i) % 2 == 0) {
                    cl.items.push(CheckItem.checked(names[i]));
                } else {
                    cl.items.push(CheckItem.new(names[i]));
                }
            }
            ListState pick_state = ListState.new();
            pick_state.select(frame % 4);
            cl.render(area, buf, &pick_state);
        } else if (selected == 26) {
            Log journal = Log.new().block(Block.new().title("service log")).update_interval(200);
            i64 frame = update_frame(ticks, journal.update_interval_ms());
            LogLevel floor = LogLevel.Trace;
            if (frame / 16 % 3 == 1) {
                floor = LogLevel.Info;
            } else if (frame / 16 % 3 == 2) {
                floor = LogLevel.Error;
            }
            journal = journal.min_level(floor);
            for (i64 i = 0; i < 20; i = i + 1) {
                LogLevel lv = LogLevel.Info;
                if (i % 5 == 3) {
                    lv = LogLevel.Warn;
                } else if (i % 5 == 4) {
                    lv = LogLevel.Error;
                } else if (i % 5 == 0) {
                    lv = LogLevel.Debug;
                }
                String entry = @format("worker {} heartbeat #{}", i % 3, frame + i);
                journal.push(entry.to_str(), lv);
                entry.drop();
            }
            String live = @format("update #{} live", frame);
            journal.push(live.to_str(), LogLevel.Info);
            live.drop();
            LogState log_state = LogState.new();
            journal.render(area, buf, &log_state);
        } else if (selected == 27) {
            Toasts toasts = Toasts.new().block(Block.new().title("notifications"));
            i64 phase = ticks % 60;
            if (phase < 20) {
                toasts.push("compiling workspace", LogLevel.Info, (20 - phase) * 100);
            }
            if (phase >= 10 && phase < 30) {
                toasts.push("tests green", LogLevel.Info, (30 - phase) * 100);
            }
            if (phase >= 20 && phase < 40) {
                toasts.push("cache is stale", LogLevel.Warn, (40 - phase) * 100);
            }
            toasts.render(area, buf);
        } else if (selected == 28) {
            Calendar cal = Calendar.new().block(Block.new().title("month view")).update_interval(400).show_surrounding(true);
            i64 frame = update_frame(ticks, cal.update_interval_ms());
            CalendarState st = CalendarState.new(2026, 9);
            st.move_month(frame % 3 - 1);
            if (frame / 6 % 2 == 0) {
                cal.mark_day(7);
                cal.mark_day(14);
                cal.mark_day(21);
            } else {
                cal.mark_day(4);
                cal.mark_day(11);
                cal.mark_day(25);
            }
            st.select(10 + frame % 8);
            cal.render(area, buf, &st);
        }
    }

impl Showcase {
    void render_text(&self, &mut Buffer buf, &Rect area) {
        PreviewTheme theme = self.current_theme();
        Vec<Constraint> vcs = Vec<Constraint>.new();
        vcs.push(Constraint.Length((u16)5));
        vcs.push(Constraint.Fill((u16)1));
        Layout halves = Layout.new(Direction.Vertical, move vcs);
        Vec<Rect> rows = halves.split(*area);

        Text wrap_src = Text.from("Paragraph reflows this prose to fit the pane. Resize the terminal to watch greedy word wrap re-break these lines live.");
        Paragraph wrapped = Paragraph.new(move wrap_src).block(Block.new().title(" wrap ").border_style(theme.frame));
        wrapped.render(rows.get_ptr((i64)0), buf);

        // Alignment row: three mini paragraphs.
        Vec<Constraint> hcs = Vec<Constraint>.new();
        hcs.push(Constraint.Fill((u16)1));
        hcs.push(Constraint.Fill((u16)1));
        hcs.push(Constraint.Fill((u16)1));
        Layout thirds = Layout.new(Direction.Horizontal, move hcs);
        Rect* halfp = rows.get_ptr((i64)1);
        Rect half = *halfp;
        Vec<Rect> cols = thirds.split(half);
        Text tl = Text.from("left");
        Paragraph pl = Paragraph.new(move tl).alignment(Alignment.Left).block(Block.new().border_style(theme.frame));
        pl.render(cols.get_ptr((i64)0), buf);
        Text tc = Text.from("center");
        Paragraph pc = Paragraph.new(move tc).alignment(Alignment.Center).block(Block.new().border_style(theme.frame));
        pc.render(cols.get_ptr((i64)1), buf);
        Text tr = Text.from("right");
        Paragraph pr = Paragraph.new(move tr).alignment(Alignment.Right).block(Block.new().border_style(theme.frame));
        pr.render(cols.get_ptr((i64)2), buf);
    }

    void render_state(&self, &mut Buffer buf, &Rect area) {
        // Ticks poll constantly; p pauses the motion, u steps one frame.
        PreviewTheme theme = self.current_theme();
        str spins = "|/-\\";
        u8* sb = (u8*)spins;
        i64 frame = self.ticks % 4;
        u8 buf2[64];
        buf2[0] = (u8)116; // 't'
        buf2[1] = (u8)105; // 'i'
        buf2[2] = (u8)99;  // 'c'
        buf2[3] = (u8)107; // 'k'
        buf2[4] = (u8)58;  // ':'
        buf2[5] = (u8)32;  // ' '
        buf2[6] = sb[frame];
        buf2[7] = (u8)0;
        String tick_line = String.from_str(play_label(self.playing));
        Text t = Text.from(tick_line.to_str());
        Paragraph p = Paragraph.new(move t).block(Block.new().title(" live updates ").title_style(theme.accent).border_style(theme.frame));
        p.render(area, buf);
        tick_line.drop();
        // Snapshot status line.
        Rect inner = Block.new().inner(*area);
        if ((i64)inner.height >= 4) {
            buf.set_string((i64)inner.x + 1, (i64)inner.y + 2, (str)&buf2[0], Style.new().bold(), 12);
            String msg = @format("snapshot: {}", self.snap_status.to_str());
            buf.set_string((i64)inner.x + 1, (i64)inner.y + 3, msg.to_str(), theme.body, (i64)inner.width - 2);
            msg.drop();
        }
    }

    void render_bar(&self, &mut Buffer buf, &Rect area) {
        PreviewTheme theme = self.current_theme();
        String bar = @format("tabs 1/2/3 · {}/{} · {} · theme {} · updates {} · p play · t theme · u step · flash {} · q quit", self.hint.to_str(), self.snap_status.to_str(), play_label(self.playing), theme.name, self.ticks, blink_label(self.blink_enabled));
        Text ft = Text.from(bar.to_str());
        Paragraph fp = Paragraph.new(move ft).style(theme.muted);
        fp.render(area, buf);
        bar.drop();
    }
}

str play_label(bool playing) {
    if (playing) {
        return "playing";
    }
    return "paused";
}

str blink_label(bool enabled) {
    if (enabled) {
        return "on";
    }
    return "off";
}

i32 main() {
    Showcase app;
    app.items = List.new(showcase_items()).highlight_symbol("> ").block(Block.new().title(" widgets "));
    app.picked = ListState.new();
    app.tab = 0;
    app.hint = String.from_str("press keys");
    app.snap_status = String.from_str("no snapshot yet");
    app.ticks = 0;
    app.playing = true;
    app.theme = 0;
    app.blink_enabled = false;
    app.blink_pending = false;
    app.blink_mask = (u8)0;
    // `--inline` runs the same showcase in a scrollback region (agent-CLI
    // style) instead of the alt screen; 12 rows keeps it compact.
    String flag = arg(1);
    bool inline_mode = flag.equals("--inline");
    flag.drop();
    if (inline_mode) {
        run_app_view(&mut app, Viewport.Inline((u16)12));
    } else {
        run_app(&mut app);
    }
    return 0;
}
