import atelier.style;
import std.test;

#[test]
void style_builders_and_patch() {
    Style s = Style.new().fg(Color.Red).bold();
    Style t = Style.new().bg(Color.Blue);
    Style u = s.patch(t);
    Color red = Color.Red;
    Color blue = Color.Blue;
    assert_true(u.fg == red, "patch keeps fg");
    assert_true(u.bg == blue, "patch takes bg");
    assert_true((u.add_mod & MOD_BOLD) != (u16)0, "patch keeps mods");
}
