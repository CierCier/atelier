import atelier.widgets.gauge;
import atelier.buffer;
import atelier.layout;
import std.test;

i64 cp(Buffer* buf, i64 x, i64 y) {
    Cell* c = buf.cell_mut(x, y);
    if (c == (Cell*)0) {
        return 0;
    }
    return (i64)c.ch;
}

#[test]
void gauge_fills_by_percentage() {
    Rect area = Rect.new((u16)0, (u16)0, (u16)10, (u16)1);
    Buffer buf = Buffer.empty(area);
    Gauge g = Gauge.new().percent((u16)50).label("50%");
    g.render(&area, &buf);
    assert_eq_i64(0x2588, (i64)buf.cell_mut(0, 0).ch, "filled half starts full");
    assert_eq_i64(0x2591, (i64)buf.cell_mut(9, 0).ch, "empty half ends light");
}

#[test]
void sparkline_renders_latest_values() {
    Vec<u16> values = Vec<u16>.new();
    values.push((u16)0);
    values.push((u16)100);
    Sparkline spark = Sparkline.new(move values).max_value((u16)100);
    Rect graph = Rect.new((u16)0, (u16)0, (u16)2, (u16)1);
    Buffer graph_buf = Buffer.empty(graph);
    spark.render(&graph, &graph_buf);
    assert_eq_i64(0x2588, (i64)graph_buf.cell_mut(1, 0).ch, "maximum is full block");
}

#[test]
void bar_chart_and_spinner_render() {
    Vec<BarItem> bars = Vec<BarItem>.new();
    bars.push(BarItem.new("cpu", (u16)100));
    BarChart chart = BarChart.new(move bars).max_value((u16)100);
    Rect bars_area = Rect.new((u16)0, (u16)0, (u16)8, (u16)1);
    Buffer bars_buf = Buffer.empty(bars_area);
    chart.render(&bars_area, &bars_buf);
    assert_eq_i64(0x2588, (i64)bars_buf.cell_mut(5, 0).ch, "bar chart fills its range");
    Spinner spinner = Spinner.new("wait");
    spinner.next();
    Rect spinner_area = Rect.new((u16)0, (u16)0, (u16)8, (u16)1);
    Buffer spinner_buf = Buffer.empty(spinner_area);
    spinner.render(&spinner_area, &spinner_buf);
    assert_eq_i64(0x2819, (i64)spinner_buf.cell_mut(0, 0).ch, "spinner advances frame");
}

#[test]
void line_gauge_fills_and_labels_ratio() {
    LineGauge line = LineGauge.new().ratio(1, 2);
    Rect line_area = Rect.new((u16)0, (u16)0, (u16)12, (u16)1);
    Buffer line_buf = Buffer.empty(line_area);
    line.render(&line_area, &line_buf);
    assert_eq_i64(0x2588, (i64)line_buf.cell_mut(0, 0).ch, "line gauge starts filled");
    assert_eq_i64(0x2591, (i64)line_buf.cell_mut(6, 0).ch, "line gauge ends its bar empty");
    assert_eq_i64(0x35, (i64)line_buf.cell_mut(8, 0).ch, "line gauge suffix shows percent");
}

#[test]
void meters_fill_tall_areas_with_fractional_tips() {
    Gauge tall = Gauge.new().percent((u16)55).label("L");
    Rect tall_area = Rect.new((u16)0, (u16)0, (u16)10, (u16)3);
    Buffer tall_buf = Buffer.empty(tall_area);
    tall.render(&tall_area, &tall_buf);
    assert_eq_i64(0x2588, (i64)tall_buf.cell_mut(0, 2).ch, "gauge fills bottom row");
    assert_eq_i64(0x258C, (i64)tall_buf.cell_mut(5, 0).ch, "gauge tip is a partial block");
    assert_eq_i64(0x4C, (i64)tall_buf.cell_mut(4, 1).ch, "gauge label sits mid-box");
    LineGauge tall_line = LineGauge.new().ratio(1, 2);
    Rect tall_line_area = Rect.new((u16)0, (u16)0, (u16)12, (u16)3);
    Buffer tall_line_buf = Buffer.empty(tall_line_area);
    tall_line.render(&tall_line_area, &tall_line_buf);
    assert_eq_i64(0x2588, (i64)tall_line_buf.cell_mut(0, 2).ch, "line gauge fills bottom row");
    assert_eq_i64(0x258C, (i64)tall_line_buf.cell_mut(3, 2).ch, "line gauge tip is partial");
    assert_eq_i64(0x35, (i64)tall_line_buf.cell_mut(8, 1).ch, "line gauge suffix on middle row");
    assert_eq_i64(0, (i64)tall_line_buf.cell_mut(8, 2).ch, "no suffix off the middle row");
}

#[test]
void bar_chart_fractional_tip_and_centered_spinner() {
    Vec<BarItem> tip_bars = Vec<BarItem>.new();
    tip_bars.push(BarItem.new("cpu", (u16)62));
    BarChart tip_chart = BarChart.new(move tip_bars).max_value((u16)100);
    Rect tip_area = Rect.new((u16)0, (u16)0, (u16)8, (u16)1);
    Buffer tip_buf = Buffer.empty(tip_area);
    tip_chart.render(&tip_area, &tip_buf);
    assert_eq_i64(0x258D, (i64)tip_buf.cell_mut(6, 0).ch, "bar tip is a partial block");
    Spinner tall_spin = Spinner.new("wait");
    Rect spin_area = Rect.new((u16)0, (u16)0, (u16)8, (u16)3);
    Buffer spin_buf = Buffer.empty(spin_area);
    tall_spin.render(&spin_area, &spin_buf);
    assert_eq_i64(0, (i64)spin_buf.cell_mut(0, 0).ch, "spinner leaves top row empty");
    assert_eq_i64(0x280B, (i64)spin_buf.cell_mut(0, 1).ch, "spinner centers vertically");
}

#[test]
void sparkline_rtl_mirrors_flow() {
    // Two values, 4-wide window: values [100, 0] — newest is 0.
    Vec<u16> values = Vec<u16>.new();
    values.push((u16)100);
    values.push((u16)0);
    Sparkline spark = Sparkline.new(move values).max_value((u16)100);
    Rect area = Rect.new((u16)0, (u16)0, (u16)4, (u16)1);
    Buffer buf = Buffer.empty(area);
    spark.render(&area, &buf);
    // LTR partial window hugs the right edge: untouched, untouched, █, blank.
    assert_eq_i64(0, cp(&buf, 0, 0), "ltr partial window leaves left untouched");
    assert_eq_i64(0x2588, cp(&buf, 2, 0), "ltr history sits left of newest");
    Vec<u16> back = Vec<u16>.new();
    back.push((u16)100);
    back.push((u16)0);
    Sparkline rtl = Sparkline.new(move back).max_value((u16)100).rtl(true);
    Buffer rtl_buf = Buffer.empty(area);
    rtl.render(&area, &rtl_buf);
    // RTL mirrors: newest at the left edge, history flowing rightward.
    assert_eq_i64(0x20, cp(&rtl_buf, 0, 0), "rtl newest value at left edge");
    assert_eq_i64(0x2588, cp(&rtl_buf, 1, 0), "rtl history flows rightward");
    assert_eq_i64(0, cp(&rtl_buf, 3, 0), "rtl right side stays untouched");
    // Full window: values [0, 100, 0, 50], newest (50) at the right in LTR,
    // at the left in RTL.
    Vec<u16> full = Vec<u16>.new();
    full.push((u16)0);
    full.push((u16)100);
    full.push((u16)0);
    full.push((u16)50);
    Sparkline full_rtl = Sparkline.new(move full).max_value((u16)100).rtl(true);
    Buffer full_buf = Buffer.empty(area);
    full_rtl.render(&area, &full_buf);
    assert_eq_i64(0x2584, cp(&full_buf, 0, 0), "rtl newest value lands at the left edge");
    assert_eq_i64(0x20, cp(&full_buf, 1, 0), "rtl next-newest zero renders as blank tick");
    assert_eq_i64(0x2588, cp(&full_buf, 2, 0), "rtl 100 follows rightward");
    // LTR twin for contrast: newest at the right edge.
    Vec<u16> full_copy = Vec<u16>.new();
    full_copy.push((u16)0);
    full_copy.push((u16)100);
    full_copy.push((u16)0);
    full_copy.push((u16)50);
    Sparkline full_ltr = Sparkline.new(move full_copy).max_value((u16)100);
    Buffer ltr_buf = Buffer.empty(area);
    full_ltr.render(&area, &ltr_buf);
    assert_eq_i64(0x2584, cp(&ltr_buf, 3, 0), "ltr newest value stays at the right edge");
}
