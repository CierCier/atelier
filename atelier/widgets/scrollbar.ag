// Scrollbar: a standalone vertical position indicator. It intentionally
// consumes a caller-provided rectangle so lists, logs, trees, and tables can
// reserve their own gutter without a container hierarchy.

import atelier.buffer;
import atelier.layout;
import atelier.style;
import atelier.update;
import atelier.widget;
import atelier.widgets.block;

struct ScrollbarState {
    i64 content_length;
    i64 position;
}
impl ScrollbarState {
    ScrollbarState new(i64 content_length) {
        ScrollbarState s;
        s.content_length = content_length;
        s.position = 0;
        return s;
    }

    void set_position(&mut self, i64 position) {
        self.position = position;
    }

    void set_content_length(&mut self, i64 length) {
        self.content_length = length;
    }
}

enum ScrollbarOrientation {
    Vertical;
    Horizontal;
}

struct Scrollbar {
    UpdateInterval cadence;
    ScrollbarOrientation orientation;
    Style track_style;
    Style thumb_style;
    str track_symbol;
    str thumb_symbol;
    str begin_symbol;
    str end_symbol;
    Block block;
    bool has_block;
}

impl Scrollbar {
    Scrollbar new() {
        Scrollbar s;
        s.cadence = UpdateInterval.new(0);
        s.orientation = ScrollbarOrientation.Vertical;
        s.track_style = Style.new().fg(Color.BrightBlack);
        s.thumb_style = Style.new().fg(Color.White);
        s.track_symbol = "░";
        s.thumb_symbol = "█";
        s.begin_symbol = (str)0;
        s.end_symbol = (str)0;
        s.block = Block.new();
        s.has_block = false;
        return s;
    }

    Scrollbar orientation(Scrollbar self, ScrollbarOrientation orientation) {
        self.orientation = orientation;
        return self;
    }

    Scrollbar end_symbols(Scrollbar self, str begin, str end) {
        self.begin_symbol = begin;
        self.end_symbol = end;
        return self;
    }

    Scrollbar track_style(Scrollbar self, Style style) {
        self.track_style = style;
        return self;
    }

    Scrollbar thumb_style(Scrollbar self, Style style) {
        self.thumb_style = style;
        return self;
    }

    Scrollbar symbols(Scrollbar self, str track, str thumb) {
        self.track_symbol = track;
        self.thumb_symbol = thumb;
        return self;
    }

    Scrollbar block(Scrollbar self, Block block) {
        self.block = block;
        self.has_block = true;
        return self;
    }

    Scrollbar update_interval(Scrollbar self, i64 interval_ms) {
        self.cadence = self.cadence.interval(interval_ms);
        return self;
    }

    i64 update_interval_ms(&self) {
        return self.cadence.milliseconds();
    }

    i64 advance(&mut self, i64 elapsed_ms) {
        return self.cadence.advance(elapsed_ms);
    }
}

impl StatefulWidget for Scrollbar {
    type State = ScrollbarState;

    void render(&self, &Rect area, &mut Buffer buf, &mut ScrollbarState state) {
        Rect inner = *area;
        if (self.has_block) {
            self.block.render(area, buf);
            inner = self.block.inner(*area);
        }
        if (inner.width == (u16)0 || inner.height == (u16)0) {
            return;
        }
        ScrollbarOrientation horizontal_tag = ScrollbarOrientation.Horizontal;
        bool horizontal = self.orientation == horizontal_tag;
        i64 length = (i64)inner.height;
        if (horizontal) {
            length = (i64)inner.width;
        }
        // End symbols cap the track; the thumb travels between them.
        i64 start = 0;
        i64 end = length;
        if (self.begin_symbol != (str)0 && length > 0) {
            start = 1;
        }
        if (self.end_symbol != (str)0 && end - start > 0) {
            end = end - 1;
        }
        i64 top = 0;
        i64 size = 0;
        scrollbar_extent(end - start, state.content_length, state.position, &top, &size);
        top = top + start;
        for (i64 i = 0; i < length; i = i + 1) {
            bool is_thumb = i >= top && i < top + size;
            str glyph = self.track_symbol;
            Style st = self.track_style;
            if (is_thumb) {
                glyph = self.thumb_symbol;
                st = self.thumb_style;
            }
            if (i == 0 && start > 0) {
                glyph = self.begin_symbol;
            }
            if (i == length - 1 && end < length) {
                glyph = self.end_symbol;
            }
            if (horizontal) {
                buf.set_string((i64)inner.x + i, (i64)inner.y, glyph, st, 1);
            } else {
                buf.set_string((i64)inner.x, (i64)inner.y + i, glyph, st, 1);
            }
        }
    }
}

/// Thumb offset/size for a track of `length` cells over `content` items.
void scrollbar_extent(i64 length, i64 content, i64 position, i64* out_top, i64* out_size) {
    if (content < 1) { content = 1; }
    i64 size = length * length / content;
    if (size < 1) { size = 1; }
    if (size > length) { size = length; }
    i64 max_position = content - length;
    if (max_position < 0) { max_position = 0; }
    if (position < 0) { position = 0; }
    if (position > max_position) { position = max_position; }
    i64 top = 0;
    if (max_position > 0) { top = position * (length - size) / max_position; }
    *out_top = top;
    *out_size = size;
}
